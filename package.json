{
  "name": "radarsimapp",
  "version": "1.0.0",
  "description": "Radar simulation desktop app — model waveforms, targets, and antenna arrays with real-time Range-Doppler visualization",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && tsc -p tsconfig.renderer.json && node scripts/emit-renderer-pkg.js",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --dev",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "generate-gif": "node scripts/generate-install-gif.js",
    "test": "npm run build && node --test \"test/**/*.test.mts\"",
    "test:unit": "npm run build && node --test \"test/unit/**/*.test.mts\"",
    "test:integration": "npm run build && node --test \"test/integration/**/*.test.mts\"",
    "test:watch": "node --test --watch \"test/**/*.test.mts\"",
    "typecheck:test": "npm run build && tsc -p tsconfig.test.json"
  },
  "engines": {
    "node": ">=26"
  },
  "author": "RadarSimX",
  "license": "SEE LICENSE IN LICENSE.txt",
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.2",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "gif-encoder-2": "^1.0.5",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "h5wasm": "^0.10.1",
    "koffi": "^2.16.2",
    "plotly.js-dist": "^3.5.1"
  },
  "build": {
    "appId": "com.radarsimx.radarsimapp",
    "productName": "RadarSimApp",
    "copyright": "Copyright © 2026 RadarSimX, LLC",
    "win": {
      "target": "squirrel",
      "icon": "renderer/assets/logo.ico",
      "legalTrademarks": "RadarSimX, LLC"
    },
    "mac": {
      "target": "dmg",
      "icon": "renderer/assets/logo.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "renderer/assets/logo.png"
    },
    "squirrelWindows": {
      "loadingGif": "renderer/assets/install.gif"
    },
    "files": [
      "dist/**",
      "renderer/**",
      "radarsimlib/**",
      "node_modules/**",
      "!**/*.ts",
      "!**/*.d.ts",
      "!tsconfig*.json",
      "!radarsimlib/*.lib",
      "!dist/renderer/js/package.json"
    ],
    "asarUnpack": [
      "radarsimlib/**",
      "node_modules/koffi/**"
    ]
  }
}
