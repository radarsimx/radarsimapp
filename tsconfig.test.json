{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    // Tests run straight off source via Node's type stripping; nothing is emitted.
    "noEmit": true,
    "allowImportingTsExtensions": true,
    // dist/ is emitted without declarations, so let tsc infer from the JS.
    "allowJs": true,
    "checkJs": false
  },
  // The renderer's and the bridge's global types, for the modules the tests
  // take their types from (typeof import of the sources they exercise).
  "include": ["test/**/*.ts", "test/**/*.mts", "renderer/ts/types.d.ts", "sim-types.d.ts"]
}
